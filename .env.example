# All paths are local. Never commit keys, models, or private game records.
PORT=3001
# Default: automatically download and manage KataGo. No engine paths required.
# Optional cache override; defaults to <source>/.local/katago (desktop package: userData/katago).
# GO_TRAINER_DATA_DIR=
# Private LLM settings default to <source>/.local/settings (package: userData/settings).
# GO_TRAINER_SETTINGS_DIR=
# Set KATAGO_MODEL to opt into an existing custom installation (CUDA/TensorRT etc).
# KATAGO_PATH=/absolute/path/to/katago
# KATAGO_MODEL=/absolute/path/to/main-model.bin.gz
# KATAGO_CONFIG=./config/katago/analysis.cfg
# KATAGO_HUMAN_MODEL=/absolute/path/to/b18c384nbt-humanv0.bin.gz
KATAGO_TIMEOUT_MS=180000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# UI settings take precedence. default omits the effort override.
DEEPSEEK_EFFORT=default
CODEX_PATH=codex
CLAUDE_PATH=claude
CODEX_MODEL=
CODEX_EFFORT=default
CLAUDE_MODEL=
CLAUDE_EFFORT=default
# Windows npm .cmd shims: instead set *_PATH=node and *_SCRIPT to the CLI's JS entrypoint.
CODEX_SCRIPT=
CLAUDE_SCRIPT=
LLM_TIMEOUT_MS=120000
